{
  "name": "dsh-unity-search",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 统一检索插件：默认接管 web_search 引擎链（免 key 兜底），常驻 search_sources/read_source 两工具提供多源证据信封与有界阅读（SSRF 校验 + 全量落盘），自带 unity-search 技能与「统一搜索」设置节。",
  "type": "module",
  "main": "./src/adapter/index.js",
  "exports": {
    ".": "./src/adapter/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "files": [
    "src/",
    "dist/",
    "skills/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "check": "node build-client.mjs --check && node ../../tools/plugin-layering-check.mjs . && node --test test/*.test.mjs",
    "layering": "node ../../tools/plugin-layering-check.mjs .",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-web": "0.1.2-rc.1",
    "esbuild": "^0.28.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
